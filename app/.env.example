# Copy to .env for local development. On Railway these go in Variables.

# Provided automatically by Railway when you attach a Postgres database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prodough

# Signs session cookies. Generate with:  openssl rand -base64 48
# Changing this signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Your live URL, no trailing slash. Used to build approval links.
PUBLIC_URL=https://your-app.up.railway.app

# Web push. Generate with:  npm run vapid
# Push is silently disabled if these are unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:lowry@powder-ops.com

# Local timezone and the hour (0-23) the daily nudge fires.
APP_TZ=America/Denver
NUDGE_HOUR=8

# Only needed if you drive the cron jobs over HTTP instead of in-process.
CRON_SECRET=

# Used once by `npm run seed`. Leave the passwords blank to have them generated
# and printed. Delete these variables afterwards.
SEED_OWNER_EMAIL=lowry@powder-ops.com
SEED_OWNER_NAME=Lowry Akers
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=marnee@powder-ops.com
SEED_STAFF_NAME=Marnee Dortch
SEED_STAFF_PASSWORD=
