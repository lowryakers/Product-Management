{
  "name": "prodough-pm",
  "version": "0.1.0",
  "private": true,
  "description": "ProDough product management — SKUs, specs, artwork, NFPs, quotes, POs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx prisma/seed.ts",
    "vapid": "tsx scripts/gen-vapid.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^6.12.0",
    "@prisma/client": "^5.22.0",
    "fastify": "^4.28.1",
    "pdfkit": "^0.15.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.4",
    "@types/web-push": "^3.6.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
